# Hugging Face API token for downloading gated models and using the Inference API.
# Get yours at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# Weights & Biases API key for logging experiments and using the W&B inference service.
# Optional — only needed if you plan to use W&B features.
# Get yours at https://wandb.ai/authorize
WANDB_API_KEY=
